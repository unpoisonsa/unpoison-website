---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Take action" description="Find a practical way to support safer pesticide policy, report an incident, join a local campaign or fund UnPoison's work.">
  <header class="page-hero shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-current="page">Take action</span></nav>
    <p class="eyebrow">Practical routes to participate</p>
    <h1>Take action</h1>
    <p class="lede">Choose the route that fits what you know, where you live and how you can contribute. Each action strengthens the wider case for safer policy.</p>
  </header>
  <section class="section-compact action-band">
    <div class="shell action-routes">
      <a class="action-route" href="/resources/"><span class="number">01</span><span><h3>Use and share the evidence</h3><p>Find policy comments, research, databases and practical guidance.</p></span><span class="arrow">→</span></a>
      <a class="action-route" href="/campaigns/pesticide-free-cape-town/"><span class="number">02</span><span><h3>Organise a no-spray suburb</h3><p>Start with proven tools from Pesticide-Free Cape Town.</p></span><span class="arrow">→</span></a>
      <a class="action-route" href="/report-an-incident/"><span class="number">03</span><span><h3>Report an incident</h3><p>Help document spraying, exposure, misuse or poisoning.</p></span><span class="arrow">→</span></a>
      <a class="action-route" href="mailto:unpoisonsa@gmail.com?subject=Offer%20expertise%20to%20UnPoison"><span class="number">04</span><span><h3>Offer your expertise</h3><p>Contribute scientific, legal, agricultural, communication or community knowledge.</p></span><span class="arrow">→</span></a>
      <a class="action-route" href="/donate/"><span class="number">05</span><span><h3>Fund the work</h3><p>Sustain independent research, advocacy and public resources.</p></span><span class="arrow">→</span></a>
    </div>
  </section>
</BaseLayout>
