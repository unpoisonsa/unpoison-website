---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const resources = (await getCollection('resources'))
  .filter(({ data }) => data.featured)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);

// February 2025 snapshot from UnPoison's HHP database; review before changing the date or figures.
const pesticideFigures = [
  { value: '2,688', label: 'pesticides registered in South Africa at the time of the analysis' },
  { value: '195', label: 'highly hazardous pesticides still legal for use in South Africa' },
  { value: '116', label: 'of those 195 not approved for use in the EU' },
];
---

<BaseLayout title="UnPoison" description="Independent research, advocacy and practical action for safer pesticide policy and a healthy South Africa—for all, forever.">
  <section class="home-hero">
    <div class="home-hero-media" aria-hidden="true">
        <picture>
          <source srcset="/images/home-canopy-900.webp 900w, /images/home-canopy-1600.webp 1600w" sizes="100vw" type="image/webp" />
          <img src="/images/home-canopy-1600.webp" width="1600" height="1067" alt="" fetchpriority="high" />
        </picture>
    </div>
    <div class="shell home-hero-inner">
      <p class="home-strap">For all forever</p>
      <div class="home-hero-lockup">
        <h1><span>UnPoison</span><span>South Africa</span></h1>
        <div>
          <p class="home-introduction">UnPoison works to reduce pesticide harm in South Africa through research, policy reform and community action.</p>
          <a class="home-scroll-link" href="#the-work">Follow the work <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
  </section>

  <aside class="identity-band" aria-label="UnPoison registration">
    <div class="shell identity-band-inner">
      <p><strong>UnPoison is a registered South African nonprofit.</strong> NPO 279-035 · PBO 930082413. We publish evidence and organise practical action for safer pesticide policy.</p>
      <a class="text-link" href="/about/">About the organisation</a>
    </div>
  </aside>

  <section id="the-work" class="home-thesis">
    <div class="shell home-thesis-grid">
      <p class="section-index">Why reform is needed</p>
      <div>
        <h2>South Africa’s pesticide system was built for another era.</h2>
        <div class="home-thesis-copy">
          <p>South Africa still regulates agricultural remedies under Act 36 of 1947. The law has been amended, but UnPoison is calling for stronger safeguards, better monitoring and clearer public information about pesticide risks.</p>
          <a class="line-link" href="/why-reform/">Why reform is needed <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-figures" aria-labelledby="home-figures-title">
    <div class="shell home-figures-grid">
      <div class="home-figures-intro">
        <p class="section-index">February 2025 database</p>
        <h2 id="home-figures-title">Highly hazardous pesticides remained legal.</h2>
      </div>
      <div>
        <ul class="home-figure-list">
          {pesticideFigures.map((figure) => <li><strong>{figure.value}</strong><span>{figure.label}</span></li>)}
        </ul>
        <p class="home-figures-source">Source: <a href="/documents/unpoison-hhp-database-2025.pdf">UnPoison’s February 2025 Highly Hazardous Pesticide Database (PDF)</a>.</p>
      </div>
    </div>
  </section>

  <section class="home-current">
    <div class="shell home-current-grid">
      <div class="home-current-heading">
        <p class="section-index">Current work</p>
        <h2>Latest submissions.</h2>
        <a class="line-link" href="/resources/">Browse current resources <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-records">
          {resources.map(({ id, data }) => (
            <article class="home-record">
              <time datetime={data.published.toISOString()}>{data.published.toLocaleDateString('en-ZA', { month: 'long', year: 'numeric' })}</time>
              <div>
                <h3><a href={`/resources/${id}/`}>{data.title}</a></h3>
                <p>{data.summary}</p>
              </div>
            </article>
          ))}
      </div>
    </div>
  </section>

  <section class="home-campaign">
    <div class="home-campaign-image" aria-hidden="true"></div>
    <div class="home-campaign-copy">
      <p class="section-index">Pesticide-Free City</p>
      <h2>Let’s unpoison our city, one suburb at a time.</h2>
      <p>Communities across Cape Town are organising to stop routine roadside herbicide spraying and move toward safer, job-creating manual weed control.</p>
      <a class="line-link line-link-light" href="/campaigns/pesticide-free-cape-town/">Join the Cape Town campaign <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="home-entry-points">
    <div class="shell">
      <p class="section-index">Take part</p>
      <div class="home-entry-grid">
        <h2>What you can do.</h2>
        <nav aria-label="Ways to take action">
          <a href="/resources/"><span>Read the evidence</span><span aria-hidden="true">→</span></a>
          <a href="/report-an-incident/"><span>Report spraying or poisoning</span><span aria-hidden="true">→</span></a>
          <a href="/take-action/"><span>Contribute or organise</span><span aria-hidden="true">→</span></a>
          <a href="/donate/"><span>Fund independent advocacy</span><span aria-hidden="true">→</span></a>
        </nav>
      </div>
    </div>
  </section>
</BaseLayout>
