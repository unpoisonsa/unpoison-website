---
import BaseLayout from '../layouts/BaseLayout.astro';

const explainers = [
  { title: 'UnPoison Our Wine — Transition Roadmap for South African Wine Farmers', id: '58gekrMt7Jw', description: 'A roadmap for reducing dependence on harmful agrichemicals in South African wine farming.' },
  { title: 'UnPoison Our Air — Agrichemical Spray Drift in South Africa', id: 'yxWBprX6KmM', description: 'Why spray drift matters for people and places beyond the treated field.' },
  { title: 'UnPoison Our Owls & Raptors', id: 'S5eLo2fjfbk', description: 'The effects of poison on birds of prey and the wider living system.' },
  { title: 'UnPoison Our Water', id: 'cSD7rlCKRqM', description: 'Pesticides, water and the need to protect shared resources.' },
  { title: 'UnPoison Our Legislation', id: 'ckDX2MCAilA', description: 'Why South Africa’s agrichemical rules need reform.' },
  { title: 'Demystifying Highly Hazardous Pesticides in South Africa', id: '_C6aRP98-Ew', description: 'An introduction to highly hazardous pesticides in the South African context.' },
];

const featured = { title: 'UnPoison Our City', id: 'qc1jjcGwESE', description: 'A community case for moving away from routine urban spraying.' };

const conversations = [
  { title: 'Calls for banning toxic pesticides — Anna Shevel weighs in', id: 'SzbsNBPVyUw' },
  { title: 'Chemical Alert — Carte Blanche', id: 'Z79S9Ff-Qz8' },
  { title: 'Dangers and use of organophosphate', id: 'c1KjiM0Ujio' },
  { title: 'How one scientist took on the chemical industry', id: 'ezVEzCmiXM4' },
  { title: 'Pesticides: An Expensive Business', id: 'jW-bGsN_4Pk' },
  { title: 'Calls for a pesticide ban in schools — Anna Shevel shares thoughts', id: 'm7AIwFStAQg' },
  { title: 'Women on Farms — Pesticide Exposure of Women Farmworkers', id: 'ynwY2C5ikFY' },
];

const videoUrl = (id: string) => `https://www.youtube.com/watch?v=${id}`;
const stillUrl = (id: string, quality = 'hqdefault') => `https://i.ytimg.com/vi/${id}/${quality}.jpg`;
---

<BaseLayout title="Videos" description="Watch UnPoison explainers and selected public conversations about pesticides, policy, health and practical alternatives.">
  <header class="page-hero shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span><a href="/resources/">Evidence & resources</a></span><span aria-current="page">Videos</span></nav>
    <p class="eyebrow">Watch and listen</p>
    <h1>Videos</h1>
    <p class="lede">Watch UnPoison explainers, interviews and selected news coverage. Videos open on YouTube in a new tab.</p>
  </header>

  <section class="video-feature-band section-rule" aria-labelledby="featured-video-title">
    <div class="shell video-feature">
      <a class="video-feature-media" href={videoUrl(featured.id)} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${featured.title} on YouTube (opens in a new tab)`}>
        <img src={stillUrl(featured.id, 'maxresdefault')} width="1280" height="720" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
        <span class="video-play-mark" aria-hidden="true">▶</span>
      </a>
      <div class="video-feature-copy">
        <p class="eyebrow">Featured explainer</p>
        <h2 id="featured-video-title">{featured.title}</h2>
        <p>{featured.description}</p>
        <a class="line-link line-link-light" href={videoUrl(featured.id)} target="_blank" rel="noopener noreferrer">Watch on YouTube <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
      </div>
    </div>
  </section>

  <section class="section-compact section-rule">
    <div class="shell">
      <div class="video-section-heading">
        <p class="eyebrow">UnPoison explainers</p>
        <h2>Spray drift, wildlife, water and law.</h2>
        <p>For reports and policy submissions on these issues, see the <a href="/resources/">evidence library</a>.</p>
      </div>
      <ul class="video-gallery">
        {explainers.map((video, index) => <li>
          <a class="video-card" href={videoUrl(video.id)} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${video.title} on YouTube (opens in a new tab)`}>
            <span class="video-card-still"><img src={stillUrl(video.id)} width="480" height="360" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /><span class="video-card-play" aria-hidden="true">▶</span></span>
            <span class="video-card-copy"><span class="video-card-number">{String(index + 1).padStart(2, '0')} / EXPLAINER</span><strong>{video.title}</strong><span>{video.description}</span></span>
          </a>
        </li>)}
      </ul>
    </div>
  </section>

  <section class="section-compact section-rule">
    <div class="shell">
      <div class="video-section-heading">
        <p class="eyebrow">Public conversations</p>
        <h2>Interviews and news coverage.</h2>
      </div>
      <ul class="video-gallery video-gallery--compact">
        {conversations.map((video, index) => <li>
          <a class="video-card" href={videoUrl(video.id)} target="_blank" rel="noopener noreferrer" aria-label={`Watch ${video.title} on YouTube (opens in a new tab)`}>
            <span class="video-card-still"><img src={stillUrl(video.id)} width="480" height="360" alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" /><span class="video-card-play" aria-hidden="true">▶</span></span>
            <span class="video-card-copy"><span class="video-card-number">{String(index + 1).padStart(2, '0')} / CONVERSATION</span><strong>{video.title}</strong></span>
          </a>
        </li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
