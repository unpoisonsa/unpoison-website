---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Contact UnPoison about research, policy, campaigns, media, collaboration and support in South Africa.">
  <header class="page-hero shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-current="page">Contact</span></nav>
    <p class="eyebrow">Get in touch</p>
    <h1>Contact UnPoison</h1>
    <p class="lede">Questions, evidence, collaboration and support all help move this work forward. Tell us what you need and we will route your message to the right person.</p>
  </header>

  <section class="section-compact section-rule">
    <div class="shell article-grid">
      <div class="contact-routes">
        <div class="contact-route">
          <h2>General enquiries and collaboration</h2>
          <p>For research, policy, partnerships, media or speaking enquiries, email the UnPoison team. Please include a short subject line and any relevant deadline.</p>
          <a class="text-link" href="mailto:unpoisonsa@gmail.com?subject=UnPoison%20enquiry">unpoisonsa@gmail.com</a>
        </div>
        <div class="contact-route">
          <h2>Incident reporting</h2>
          <p>If you want to tell us about spraying, exposure or poisoning, first read what information is useful and where to get urgent support.</p>
          <a class="text-link" href="/report-an-incident/">How to report an incident</a>
        </div>
        <div class="contact-route">
          <h2>Donor enquiries</h2>
          <p>Ask about monthly support, bank transfers, receipts or how donations support UnPoison's public-interest work.</p>
          <a class="text-link" href="/donate/">Support our work</a>
        </div>
      </div>
      <aside class="article-aside" aria-label="Organisation details">
        <p class="eyebrow">Organisation details</p>
        <dl>
          <dt>Legal name</dt><dd>UnPoison</dd>
          <dt>Registered NPO</dt><dd>279-035</dd>
          <dt>PBO number</dt><dd>930082413</dd>
          <dt>Location</dt><dd>South Africa</dd>
          <dt>Email</dt><dd><a href="mailto:unpoisonsa@gmail.com">unpoisonsa@gmail.com</a></dd>
        </dl>
        <p class="fine-print">For questions about your personal information, see our <a href="/privacy/">privacy information</a>.</p>
      </aside>
    </div>
  </section>
</BaseLayout>
