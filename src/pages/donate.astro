---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Support our work" description="Support UnPoison's independent research, policy advocacy and public-interest resources.">
  <header class="page-hero shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-current="page">Support our work</span></nav>
    <p class="eyebrow">Independent research and advocacy</p>
    <h1>Support our work</h1>
    <p class="lede">Your support helps UnPoison sustain independent research, publish public resources, convene expertise and advocate for laws that protect everyone.</p>
  </header>
  <section class="section-compact section-rule">
    <div class="shell article-grid">
      <article class="article-body">
        <h2>Make a once-off donation</h2>
        <p>Choose an amount in South African rand. You will continue to PayFast to complete the payment. PayFast handles your payment details.</p>
        <form class="donation-form" action="https://www.payfast.co.za/eng/process" method="post">
          <input type="hidden" name="cmd" value="_paynow" />
          <input type="hidden" name="receiver" value="19983507" />
          <input type="hidden" name="item_name" value="UnPoison Advocacy" />
          <label for="donation-amount">Donation amount (ZAR)<input id="donation-amount" type="number" name="amount" min="5" step="0.01" value="100" inputmode="decimal" required /></label>
          <button class="button" type="submit">Continue to PayFast <span aria-hidden="true">↗</span></button>
        </form>
        <p class="fine-print">Check that PayFast shows UnPoison as the recipient before paying. Please do not enter card details on this website.</p>
        <h2>What your support makes possible</h2>
        <p>Donations help us research pesticide impacts, respond to policy proposals, make public information usable and support community-led alternatives to harmful routine spraying.</p>
      </article>
      <aside class="article-aside">
        <p class="eyebrow">Other ways to help</p>
        <h3>Monthly support or EFT</h3>
        <p>Email us for the current recurring-donation or bank-transfer details. We will send the relevant instructions directly.</p>
        <a class="button" href="mailto:unpoisonsa@gmail.com?subject=Supporting%20UnPoison">Ask about giving</a>
        <p class="fine-print">UnPoison is registered as NPO 279-035 and PBO 930082413. For receipt enquiries, email us before donating.</p>
      </aside>
    </div>
  </section>
</BaseLayout>
