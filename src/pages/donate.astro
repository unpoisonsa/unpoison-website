---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Support our work" description="Support UnPoison's independent research, policy advocacy and public-interest resources.">
  <header class="page-hero shell">
    <nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-current="page">Support our work</span></nav>
    <p class="eyebrow">Independent research and advocacy</p>
    <h1>Support our work</h1>
    <p class="lede">Your support helps UnPoison sustain independent research, publish public resources, convene expertise and advocate for laws that protect everyone.</p>
  </header>
  <section class="section-compact section-rule">
    <div class="shell article-grid">
      <article class="article-body">
        <h2>Donation system in transition</h2>
        <p>We are preserving the current PayFast, EFT and monthly-donation routes while we verify account ownership, recurring-payment behaviour and donor communications.</p>
        <p>The button opens the current UnPoison donation page. Please confirm that the address begins with <strong>https://unpoison.org/</strong> before entering payment information.</p>
      </article>
      <aside class="article-aside">
        <p class="eyebrow">Existing donation page</p>
        <h3>Continue to donate</h3>
        <p>Choose a once-off donation, EFT or monthly support on the existing website.</p>
        <a class="button" href="https://unpoison.org/monthly-donations/">Open donation options <span aria-hidden="true">↗</span></a>
      </aside>
    </div>
  </section>
</BaseLayout>
