---
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const nav = [
  { href: '/about/', label: 'About' },
  { href: '/resources/', label: 'Evidence & resources' },
  { href: '/campaigns/pesticide-free-cape-town/', label: 'Cape Town campaign' },
  { href: '/take-action/', label: 'Take action' },
  { href: '/contact/', label: 'Contact' },
];

const active = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<a class="skip-link" href="#main-content">Skip to main content</a>
<header class:list={['site-header', { 'site-header-home': isHome }]}>
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="UnPoison home">
      <img class="brand-image" src="/brand/unpoison-wordmark.png" width="1000" height="300" alt="" />
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {nav.map((item) => (
        <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="nav-donate" href="/donate/">Donate</a>
    </nav>

    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        {nav.map((item) => (
          <a href={item.href} aria-current={active(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
        <a href="/donate/">Donate</a>
      </nav>
    </details>
  </div>
</header>
